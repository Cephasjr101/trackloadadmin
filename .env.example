# Copy to .env and fill in. This backend reads env vars directly (no dotenv
# dependency) — either `export` them in your shell, or use `env $(cat .env | xargs) node server.js`.

PORT=https://empty-trackload.onrender.com

# Comma-separated list of origins allowed to call this API from a browser.
# Include the origin you serve the LoadMatch frontend from.
CORS_ORIGIN=https://empty-trackload.onrender.com

# SQLite file path (created automatically on first run).
DB_PATH=./data/https://empty-trackload.onrender.com

# Session token lifetime, in hours.
SESSION_TTL_HOURS=168

# Set to "true" once you're behind HTTPS (Netlify/Vercel/Nginx per the frontend README)
# so the backend knows to trust X-Forwarded-Proto for its own redirect checks.
BEHIND_HTTPS_PROXY=false
